DTS_HOST=127.0.0.1
DTS_PORT=8787
DTS_DATA_DIR=.data
DTS_DRIVER=mock
DTS_ADMIN_TOKEN=change-me
DTS_PUBLIC_URL=http://127.0.0.1:8787
DTS_DASHBOARD_DIR=apps/dashboard/dist
# DTS_MASTER_KEY must be 32 random bytes encoded as base64 in production.
DTS_MASTER_KEY=
# Optional Cloudflare defaults. They can also be configured in the dashboard.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
DTS_SERVER_IPV4=
# When set, new app domains must be one label under this wildcard certificate.
DTS_TLS_DOMAIN_SUFFIX=
DTS_TLS_CERTIFICATE=
DTS_TLS_KEY=
