DTS_HOST=127.0.0.1
DTS_PORT=8787
DTS_PUBLIC_URL=https://deploy.example.com
DTS_DATA_DIR=/var/lib/deploythisshit
DTS_DASHBOARD_DIR=/opt/deploythisshit/apps/dashboard/dist
DTS_DRIVER=system
DTS_ADMIN_TOKEN=replace-with-a-long-random-token
DTS_MASTER_KEY=replace-with-32-random-bytes-as-base64
DTS_TLS_DOMAIN_SUFFIX=apps.example.com
DTS_TLS_CERTIFICATE=/etc/letsencrypt/live/deploythisshit/fullchain.pem
DTS_TLS_KEY=/etc/letsencrypt/live/deploythisshit/privkey.pem
